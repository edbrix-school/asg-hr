    <parameter name="SUB_NOMINEE" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[SELECT DH.TRANSACTION_DATE, DH.DOC_REF, DH.EMPLOYEE_POID, EM.EMPLOYEE_CODE, DH.EMPLOYEE_NAME_PASSPORT, DH.EMPLOYEE_NAME_CPR, DH.RESIDENT_STATUS, DH.CURRENT_FLAT, DH.CURRENT_BLDG, DH.CURRENT_ROAD, DH.CURRENT_BLOCK, DH.CURRENT_AREA, DH.CURRENT_PO_BOX, DH.CURRENT_HOME_TEL, DH.CURRENT_MOBILE, DH.PERSONAL_EMAIL, DH.PERMANENT_ADDRESS, DH.POSTAL_ADDRESS, DH.REMARKS, DH.PASSPORT_NO, DH.PASSPORT_EXPIRY_DT, DH.CPR_NO, DH.CPR_EXPIRY_DT
FROM HR_PERSONAL_DATA_HDR DH
INNER JOIN HR_EMPLOYEE_MASTER EM ON DH.EMPLOYEE_POID = EM.EMPLOYEE_POID
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
    </queryString>

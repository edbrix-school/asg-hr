    <subDataset name="DependentDetails" uuid="51a2238f-4dd2-413e-9dd8-417fa66096b2">
        <parameter name="DOC_KEY_POID" class="java.lang.String"/>
        <queryString>
            <![CDATA[SELECT DET_ROW_ID, NAME_PASSPORT, RELATION, VISA_SPONSOR, PASSPORT_NO, NATIONALITY, MOBILE, TELPHONE, REMARKS
FROM HR_PERSONAL_DATA_DEPENDENT
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
        </queryString>
        <field name="DET_ROW_ID" class="java.math.BigDecimal"/>
        <field name="NAME_PASSPORT" class="java.lang.String"/>
        <field name="RELATION" class="java.lang.String"/>
        <field name="VISA_SPONSOR" class="java.lang.String"/>
        <field name="PASSPORT_NO" class="java.lang.String"/>
        <field name="NATIONALITY" class="java.lang.String"/>
        <field name="MOBILE" class="java.lang.String"/>
        <field name="TELPHONE" class="java.lang.String"/>
        <field name="REMARKS" class="java.lang.String"/>
    </subDataset>
    <subDataset name="EmergencyDetails" uuid="0c59b45f-85aa-4aeb-8761-e6aafd37080e">
        <parameter name="DOC_KEY_POID" class="java.lang.String"/>
        <queryString>
            <![CDATA[SELECT DET_ROW_ID, NAME, HOME_TEL, MOBILE, EMAIL, COUNTRY, REMARKS, RELATION
FROM HR_PERSONAL_DATA_EMERGENCY
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
        </queryString>
        <field name="DET_ROW_ID" class="java.math.BigDecimal"/>
        <field name="NAME" class="java.lang.String"/>
        <field name="HOME_TEL" class="java.lang.String"/>
        <field name="MOBILE" class="java.lang.String"/>
        <field name="EMAIL" class="java.lang.String"/>
        <field name="COUNTRY" class="java.lang.String"/>
        <field name="REMARKS" class="java.lang.String"/>
        <field name="RELATION" class="java.lang.String"/>
    </subDataset>

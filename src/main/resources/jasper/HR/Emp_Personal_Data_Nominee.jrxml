    <queryString>
        <![CDATA[SELECT DET_ROW_ID, NOMINEE_TYPE, NOMINEE_NAME, RELATION, MOBILE, BANK_DETIALS, PERCENTAGE, REMARKS, TRANSLATE (ADDRESS, 'x'||CHR(10)||CHR(13), 'x') as ADDRESS

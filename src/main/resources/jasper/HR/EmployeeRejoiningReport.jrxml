	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["//shippingbahrain.com//data//ERP_REPORTS//Reports//"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String" isForPrompting="false"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT ER.*,
	EM.EMPLOYEE_NAME || EM.EMPLOYEE_NAME2 AS EMPLOYEE,
	DEPT_NAME, DESIGNATION_NAME,
	LR.DOC_REF AS LEAVE_REF, LR.LEAVE_START_DATE
  FROM HR_EMP_REJOIN_HDR ER
  LEFT OUTER JOIN HR_EMPLOYEE_MASTER EM ON ER.EMPLOYEE_POID = EM.EMPLOYEE_POID
  LEFT OUTER JOIN HR_DEPARTMENT_MASTER DM ON DM.DEPT_POID = EM.DEPARTMENT_POID
  LEFT OUTER JOIN HR_DESIGNATION_MASTER DSM ON DSM.DESIG_POID = EM.DESIGNATION_POID
  LEFT OUTER JOIN HR_LEAVE_REQUEST_HDR LR ON ER.LEAVE_REQUEST_POID = LR.TRANSACTION_POID AND ER.EMPLOYEE_POID = LR.EMPLOYEE_POID
 WHERE ER.TRANSACTION_POID =  $P{DOC_KEY_POID}]]>
	</queryString>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="EmployeeRejoiningReport" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b8f6802f-b6b4-46af-bf7d-6294f2a73b3b">
	<property name="ireport.zoom" value="1.2"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["800-114"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT LR.TRANSACTION_POID,
       LR.DOC_REF,
       LR.TRANSACTION_DATE,
       LR.DATE_OF_REJOINING,
       LR.REMARKS,
       LR.PASSPORT_RECEIVED,
       LR.RECEIVED_BY,
       LR.REMARKS_BY_HR,
       LR.EXTRA_LEAVE_DAYS,
       LR.EXTRA_ABSENT_DAYS,
       EMP.EMPLOYEE_CODE,
       EMP.EMPLOYEE_NAME,
       EMP.EMPLOYEE_NAME2,
       DES.DESIGNATION_NAME,
       DEP.DEPT_NAME,
       HIST.LEAVE_START_DATE,
       HIST.EXP_REJOIN_DATE
  FROM HR_EMP_REJOIN_HDR LR
  LEFT JOIN HR_EMPLOYEE_MASTER EMP
    ON LR.EMPLOYEE_POID = EMP.EMPLOYEE_POID
  LEFT JOIN HR_DESIGNATION_MASTER DES
    ON EMP.DESIGNATION_POID = DES.DESIG_POID
  LEFT JOIN HR_DEPARTMENT_MASTER DEP
    ON EMP.DEPARTMENT_POID = DEP.DEPT_POID
  LEFT JOIN (
        SELECT H1.SOURCE_DOC_POID,
               H1.EMPLOYEE_POID,
               H1.LEAVE_START_DATE,
               H1.EXP_REJOIN_DATE
          FROM HR_EMPLOYEE_LEAVE_HISTORY H1
         WHERE H1.LEAVE_HIST_POID = (
                   SELECT MAX(H2.LEAVE_HIST_POID)
                     FROM HR_EMPLOYEE_LEAVE_HISTORY H2
                    WHERE H2.SOURCE_DOC_POID = H1.SOURCE_DOC_POID
                      AND H2.EMPLOYEE_POID = H1.EMPLOYEE_POID
               )
    ) HIST
    ON HIST.SOURCE_DOC_POID = LR.LEAVE_REQUEST_POID
   AND HIST.EMPLOYEE_POID = LR.EMPLOYEE_POID
 WHERE LR.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="DATE_OF_REJOINING" class="java.sql.Timestamp"/>
	<field name="REMARKS" class="java.lang.String"/>
